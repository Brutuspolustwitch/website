# Arena Gladiator — Environment Variables
# Copy to .env.local and fill in your values

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site
NEXT_PUBLIC_SITE_URL=https://arena-gladiator.gg
NEXT_PUBLIC_TWITCH_CHANNEL=arena_gladiator

# Twitch API (clips, status, and OAuth login)
# Create your app at https://dev.twitch.tv/console/apps
# Set the OAuth Redirect URL to: {NEXT_PUBLIC_SITE_URL}/api/auth/twitch/callback
TWITCH_CLIENT_ID=your-twitch-client-id
TWITCH_CLIENT_SECRET=your-twitch-client-secret

# StreamElements
# Get your JWT token from: https://streamelements.com/dashboard/account/channels
# Channel ID is shown on the same page
STREAMELEMENTS_JWT_TOKEN=your-streamelements-jwt-token
STREAMELEMENTS_CHANNEL_ID=your-streamelements-channel-id

# Streamers Center API
# External API origin used by this site to import live bonus hunt data.
# Do not include a trailing slash and do not use the old domain.
STREAMERS_CENTER_API_URL=https://streamerscenter.com
STREAMERS_CENTER_API_KEY=your-streamers-center-api-key

# Secret used by cron/automation calls to GET /api/bonus-hunt/sync
BONUS_HUNT_SYNC_SECRET=your-sync-secret
